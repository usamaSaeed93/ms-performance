# ============================================
# Frontend - Node.js / Next.js
# ============================================

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/.pnpm-store/

# Next.js
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.vercel
frontend/.swc/
frontend/.turbo/

# Package Manager Lock Files (keep pnpm-lock.yaml but ignore others)
frontend/package-lock.json
frontend/yarn.lock
frontend/.yarn/
frontend/.pnp.*

# Environment Variables
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/.env*.local

# Testing
frontend/coverage/
frontend/.nyc_output/
frontend/.jest/

# IDE
frontend/.vscode/
frontend/.idea/
frontend/*.swp
frontend/*.swo
frontend/.DS_Store
frontend/.eslintcache

# Cache
frontend/.cache/
frontend/.parcel-cache/

# TypeScript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Debug logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ============================================
# Backend - Python / FastAPI
# ============================================

# Python
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/*.so
backend/.Python

# Virtual Environments
